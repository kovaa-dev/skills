#!/bin/sh
""":"

set -u
export PYTHONUTF8=1

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
script_path="$script_dir/corpus.py"
version_probe='import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'

try_python() {
    candidate=$1
    shift
    if [ -x "$candidate" ] \
        && "$candidate" -c "$version_probe" >/dev/null 2>&1; then
        exec "$candidate" "$script_path" "$@"
    fi
}

if [ -n "${DOC_RESEARCH_PYTHON:-}" ]; then
    override=$(command -v "$DOC_RESEARCH_PYTHON" 2>/dev/null || true)
    if [ -z "$override" ]; then
        override=$DOC_RESEARCH_PYTHON
    fi
    try_python "$override" "$@"
    printf 'error: DOC_RESEARCH_PYTHON is not an executable Python 3.10+: %s\n' \
        "$DOC_RESEARCH_PYTHON" >&2
    exit 127
fi

old_ifs=$IFS
IFS=:
for path_directory in $PATH; do
    if [ -z "$path_directory" ]; then
        path_directory=.
    fi
    for python_name in \
        python3 python3.20 python3.19 python3.18 python3.17 python3.16 \
        python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python; do
        try_python "$path_directory/$python_name" "$@"
    done
done
IFS=$old_ifs

system_name=$(uname -s 2>/dev/null || true)
case "$system_name" in
    Darwin)
        if command -v brew >/dev/null 2>&1; then
            install_command='brew install python'
        else
            install_command='open https://www.python.org/downloads/macos/'
        fi
        ;;
    Linux)
        if command -v apt-get >/dev/null 2>&1; then
            install_command='sudo apt-get update && sudo apt-get install -y python3'
        elif command -v dnf >/dev/null 2>&1; then
            install_command='sudo dnf install -y python3'
        elif command -v yum >/dev/null 2>&1; then
            install_command='sudo yum install -y python3'
        elif command -v zypper >/dev/null 2>&1; then
            install_command='sudo zypper install -y python3'
        elif command -v pacman >/dev/null 2>&1; then
            install_command='sudo pacman -S --needed python'
        elif command -v apk >/dev/null 2>&1; then
            install_command='sudo apk add python3'
        elif command -v xbps-install >/dev/null 2>&1; then
            install_command='sudo xbps-install -S python3'
        elif command -v nix-env >/dev/null 2>&1; then
            install_command='nix-env -iA nixpkgs.python3'
        elif command -v xdg-open >/dev/null 2>&1; then
            install_command='xdg-open https://www.python.org/downloads/'
        else
            install_command='Open https://www.python.org/downloads/'
        fi
        ;;
    *)
        install_command='Open https://www.python.org/downloads/'
        ;;
esac

printf '%s\n' 'error: Python 3.10 or newer was not found.' >&2
printf 'install: %s\n' "$install_command" >&2
exit 127
":"""

# Also accept an explicit Python interpreter, as with corpus.py. The shell
# branch above still discovers a compatible interpreter for direct execution.
import runpy
from pathlib import Path

runpy.run_path(str(Path(__file__).resolve().with_name("corpus.py")), run_name="__main__")
